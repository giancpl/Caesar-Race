# Match the project's Playwright package exactly, including its browser builds.
FROM mcr.microsoft.com/playwright:v1.57.0-noble@sha256:3bed4b1a12f2338642f3d8cba28e291deef3c66bd4a964bbeb3e57bbff511dbd
RUN npm install --prefix /opt/caesar-runtime node@24.22.3 --no-audit --no-fund
ENV PATH="/opt/caesar-runtime/node_modules/.bin:${PATH}"
WORKDIR /work
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Verification runs with the host user's IDs so artifacts stay editable.
RUN chmod 1777 /work
ENV HOME=/tmp
CMD ["node", "scripts/check-container.js"]
