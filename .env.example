# Local defaults to memory. Vercel/production always require Redis.
# npm run dev binds 0.0.0.0 for LAN testing; uncomment to keep it on this computer.
# HOST=127.0.0.1
CAESAR_STORAGE=memory
CAESAR_REDIS_REST_URL=
CAESAR_REDIS_REST_TOKEN=
CAESAR_REDIS_NAMESPACE=caesar-race:dev:v1
# Production requires at least 32 characters; use a strong random server secret.
CAESAR_RATE_LIMIT_SECRET=
# Dedicated test-only Upstash database; never use production credentials here.
CAESAR_TEST_REDIS_REST_URL=
CAESAR_TEST_REDIS_REST_TOKEN=
